{
  "name": "consomazout",
  "productName": "ConsoMazout",
  "version": "1.0.0",
  "description": "Suivi de la consommation de mazout de la maison : contenu de la cuve, pleins, statistiques et pr\u00e9visions",
  "author": "Philippe Warnon",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist-electron/main.js",
  "packageManager": "npm@11.7.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run dev",
    "dev": "concurrently -k -n ng,main,app -c blue,yellow,green \"npm:dev:ng\" \"npm:dev:main\" \"npm:dev:app\"",
    "dev:ng": "ng serve --port 4200",
    "dev:main": "tsc -p electron/tsconfig.json --watch --preserveWatchOutput",
    "dev:app": "wait-on -t 120000 tcp:localhost:4200 dist-electron/main.js dist-electron/preload.js && node scripts/start-electron-dev.mjs",
    "build": "npm run build:ng && npm run build:main",
    "build:ng": "ng build",
    "build:main": "node scripts/clean.mjs dist-electron && tsc -p electron/tsconfig.json",
    "start:prod": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "test": "ng test --watch=false && npm run test:electron",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "video": "npm run build && node scripts/video/record-demo.mjs",
    "test:electron": "vitest run --config vitest.electron.config.ts"
  },
  "devDependencies": {
    "@angular/build": "^21.2.27",
    "@angular/cli": "^21.2.27",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@types/node": "^24.19.2",
    "chart.js": "4.5.1",
    "chartjs-adapter-date-fns": "3.0.0",
    "concurrently": "^10.0.6",
    "date-fns": "4.4.0",
    "electron": "44.9.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^28.0.0",
    "playwright": "1.64.1",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.5.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "node-llama-cpp": "3.22.3",
    "openai": "7.55.0"
  }
}
